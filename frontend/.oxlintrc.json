{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/api/client",
              "**/api/types",
              "../api/*",
              "../../api/*"
            ],
            "message": "Backend communication goes through src/lib/queries.ts. See docs/decisions.md D6."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/lib/queries.ts",
        "src/api/**",
        "tests/api/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
