# Copy to .env before `docker compose up`. .env is gitignored.

# Required. Signs session cookies; the app refuses to start in production
# without it. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RATION_SESSION_SECRET=change-me-before-anything-real

# Optional.
# The port the app is published on. Change it if 8000 is taken.
RATION_PORT=8000
POSTGRES_PASSWORD=ration-dev
RATION_ENV=development

# Gives the seeded demo accounts a usable password locally. Ignored in
# production, where the seed refuses to run at all.
RATION_DEV_PASSWORD=correct-horse-battery

# --------------------------------------------------------------- telemetry
# Off by default (HLD 6: off locally, on under Compose, staging and
# production). With it off the app installs no tracer, no exporter and no
# middleware. Turn it on with the observability stack:
#   docker compose -f observability/compose.yaml up
RATION_TELEMETRY_ENABLED=false

# Where the OpenTelemetry collector listens. OTLP over HTTP; the app appends
# the signal path (/v1/traces). Under the observability stack this is
# http://collector:4318.
RATION_OTLP_ENDPOINT=http://localhost:4318

# What the service calls itself in the telemetry.
RATION_SERVICE_NAME=ration-api

# Which release is running. Carried as the service.version resource attribute
# and into the alert payload, so an alert says what to roll back. "dev" when
# unset, because a build that does not know its version should say so.
RATION_VERSION=dev

# The shopping engine resolves each ingredient's package unit and refuses one
# it does not model (g, ml, pcs). Off by default, because nothing validates
# that column yet. Turning it on is the release the staged incident uses:
# docs/runbooks/staging-the-incident.md
RATION_RESOLVE_PACKAGE_UNITS=false
